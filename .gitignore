# Локальное состояние интерфейса Obsidian
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache/

# Корзина Obsidian
.trash/

# Локальные данные и сессии Claudian
.claudian/

# Секреты проекта
.env
.env.*
!.env.example

# Python
.venv/
__pycache__/
*.py[cod]

# Jupyter
.ipynb_checkpoints/
# Локальные notebook-first лаборатории; официальный код живёт в src/
notebooks/workbench/

# Локальные исходные и производные датасеты
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Локальные модели и полные результаты запусков
artifacts/*
!artifacts/_index.md

# Cloud/Kaggle bundles and model checkpoints are reproducible build artifacts,
# not source files.  Public notebooks and lightweight plots stay versioned.
*.zip
*.tgz
*.tar.gz
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
*.dat

# Local test/tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
